{
  "_comment": "Правила разбора календаря в строки листа «Оксана» таблицы «Учет времени по проектам». Названия проектов и типов работ взяты из фактических записей листа за 2026 год — менять их надо вместе с листом. Правила проверяются СВЕРХУ ВНИЗ, срабатывает первое совпадение, поэтому специфичные шаблоны держите выше общих.",

  "sheet": "Оксана",
  "timezone": "GMT+03",
  "round_hours_to": 0.1,
  "merge_same_project_and_type": true,
  "emit_comment": false,

  "exclude": [
    "Обед",
    "ВЫХОДНОЙ",
    "Отпуск",
    "заполнить часы",
    "день рождения",
    "_др",
    "Не беспокоить"
  ],

  "projects": [
    { "match": ["Daily НЛБ", "НЛБ_", "НЛБ ", "NLB", "Развитие НЛБ"], "project": "NLB" },
    { "match": ["Ломбард Белый_Продажи", "Ломбард_продажи"], "project": "Белый ломбард (Продажи)" },
    { "match": ["Ломбард Белый", "Белый ломбард", "Ломбард_", "Ломбард "], "project": "Белый ломбард (Фин+Инж)" },
    { "match": ["Пресейл Олег"], "project": "Пресейл Олег (Прайм Топ)" },
    { "match": ["Прайм топ", "Прайм Топ", "Прайм ТОП"], "project": "Прайм ТОП" },
    { "match": ["Пресейл Росинка"], "project": "Пресейл Росинка" },
    { "match": ["Росинка"], "project": "Росинка Консалтинг" },
    { "match": ["Сириус"], "project": "Сириус" },
    { "match": ["ЭкоШиппинг", "Эко Шиппинг"], "project": "ЭкоШиппинг (2 проект)" },
    { "match": ["Трак Моторс"], "project": "Трак Моторс (2 проект)" },
    { "match": ["Лав Репаблик"], "project": "Пресейл Лав Репаблик" }
  ],

  "work_types": [
    { "match": ["Daily", "синк", "Синк", "аллокация", "аллоциру"], "work_type": "Синк -> аллоцируем на проекты" },
    { "match": ["развитие"], "work_type": "Развитие НЛБ" },
    { "match": ["трекинг", "Трекинг"], "work_type": "Трекинг задач и взаимодействие с командой заказчика (переписки, напоминание, согласование)" },
    { "match": ["Регулярная встреча", "Еженедельная", "еженедельная", "регулярн", "статус", "системн"], "work_type": "Системные встречи с командой заказчиков" },
    { "match": ["с командой НЛБ", "внутренн", "НЛБ_встреча"], "work_type": "Встречи по проекту с командой НЛБ" },
    { "match": ["разработка", "Разработка", "инженерия", "модел", "дашборд", "пульт"], "work_type": "Разработка" },
    { "match": ["презентац", "отчет", "сдача", "демо"], "work_type": "Подготовка презентаций, отчетов для заказчика" },
    { "match": ["пресейл", "Пресейл", "интервью", "снятие запроса"], "work_type": "Пресейл Снятие запроса с заказчика (встречи с заказчиком, понимание объема проекта, интервью и тп)" },
    { "match": ["источник", "ИТ-ландшафт", "формат получения данных"], "work_type": "Пресейл Проработка формата получения данных с ИТ (встречи, изучение ИС и тп)" }
  ],

  "default_project": "NLB",
  "default_work_type": "Рабочие встречи с командой заказчика и вендорами по проекту "
}
