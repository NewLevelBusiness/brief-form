{
  "_comment": "Правила разбора календаря в строки листа «Оксана» таблицы «Учет времени по проектам». Правила проверяются СВЕРХУ ВНИЗ, срабатывает первое совпадение — специфичные шаблоны держите выше общих.",

  "sheet": "Оксана",
  "timezone": "GMT+03",
  "round_hours_to": 0.25,
  "merge_same_project_and_type": true,

  "exclude": [
    "Обед",
    "ВЫХОДНОЙ",
    "Отпуск",
    "заполнить часы",
    "день рождения",
    "_др",
    "Не беспокоить"
  ],

  "projects": [
    { "match": ["Daily НЛБ", "НЛБ_", "НЛБ ", "NLB", "Развитие НЛБ"], "project": "NLB" },
    { "match": ["Ломбард Белый", "Белый ломбард", "Ломбард_", "Ломбард "], "project": "Белый ломбард (Фин+Инж)" },
    { "match": ["Прайм топ", "Прайм Топ", "Прайм ТОП"], "project": "Прайм Топ" },
    { "match": ["Росинка"], "project": "Росинка" },
    { "match": ["Loona", "Луна"], "project": "Loona" },
    { "match": ["Догма"], "project": "Догма (Продажи, Стройка)" }
  ],

  "work_types": [
    { "match": ["Daily", "синк", "Синк", "встреча с командой НЛБ", "с командой НЛБ"], "work_type": "Внутренние синки команды НЛБ (трекинг, аллокация на проекты)" },
    { "match": ["развитие"], "work_type": "Развитие НЛБ (внутренние задачи)" },
    { "match": ["трекинг", "Трекинг"], "work_type": "Трекинг задач и асинхронная координация (переписки, напоминания, согласования)" },
    { "match": ["Регулярная встреча", "Еженедельная", "еженедельная", "регулярн", "статус"], "work_type": "Системные / статусные встречи с заказчиком" },
    { "match": ["пульты", "дашборд", "макет"], "work_type": "Макеты и структура дашбордов" },
    { "match": ["сдача", "демо", "презентац"], "work_type": "Подготовка презентаций и отчётов для заказчика" },
    { "match": ["метрик", "методолог", "архитектур"], "work_type": "Методология, метрики и целевая архитектура" },
    { "match": ["выгрузка данных", "качество данных", "анализ данных", "источник"], "work_type": "Анализ процессов и качества данных" },
    { "match": ["ТЗ", "требован"], "work_type": "Требования, ТЗ и технологическое решение" },
    { "match": ["инженерия", "разработка", "Разработка"], "work_type": "Рабочие встречи (заказчик, вендоры, ИТ-команда)" },
    { "match": ["обучение"], "work_type": "Обучение пользователей (навигация, функционал, принятие решений)" },
    { "match": ["стандарт"], "work_type": "Ведение протоколов и проектной документации, организация встреч" },
    { "match": ["счет", "акт", "оплат", "договор"], "work_type": "Выставление счетов и согласование оплаты, подписание актов, доп.соглашений, актов сверки" },
    { "match": ["пресейл", "Пресейл", "КП"], "work_type": "Оценка трудозатрат и формирование КП" },
    { "match": ["вебинар", "кейс"], "work_type": "Описание кейса и подготовка материалов" }
  ],

  "default_project": "NLB",
  "default_work_type": "Рабочие встречи (заказчик, вендоры, ИТ-команда)"
}
